APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

MAX_FILE_SIZE_MB=20
MAX_PAGES=60
MAX_UNCOMPRESSED_MB=200

LIBREOFFICE_PATH=soffice
LIBREOFFICE_TIMEOUT_S=120
RENDER_DPI=150
RENDER_MAX_PX=1568

# Fallback chain in priority order, LiteLLM format "provider/model".
LLM_MODELS=[{"model":"gemini/<primary-model>","vision":true,"max_output_tokens":32000},{"model":"<provider_b>/<model>","vision":true,"max_output_tokens":32000},{"model":"<provider_c>/<model>","vision":true,"max_output_tokens":32000}]
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
LLM_REPAIR_ATTEMPTS=1

GEMINI_API_KEY=

# Generate entries with: uv run python -m app.auth.create_key --client <id>
API_KEY_PEPPER=change-me-to-a-long-random-secret
API_KEYS=[]
