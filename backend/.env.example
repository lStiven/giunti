APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

MAX_FILE_SIZE_MB=20
MAX_PAGES=60
MAX_UNCOMPRESSED_MB=200

LIBREOFFICE_PATH=soffice
LIBREOFFICE_TIMEOUT_S=120
RENDER_DPI=150
RENDER_MAX_PX=1568

# Models, providers and the default fallback chain live in llm_catalog.toml (versioned).
# LLM_CATALOG_FILE=/path/to/another_catalog.toml
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
LLM_REPAIR_ATTEMPTS=1

# API key per provider of the catalog ([providers.<id>] in llm_catalog.toml).
GEMINI_API_KEY=
LLM_API_KEYS={"groq": "", "mistral": ""}

# Generate entries with: uv run python -m app.auth.create_key --client <id>
API_KEY_PEPPER=change-me-to-a-long-random-secret
API_KEYS=[]
