# Backend configuration. Copy to .env and fill in the secrets (marked REQUIRED).
# Every variable is optional unless marked REQUIRED: the value shown is the default.

# --- Service -------------------------------------------------------------------------------
# development | production (production refuses an insecure API_KEY_PEPPER).
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Frontend origins allowed to call the API from a browser (JSON list).
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# Frontend address, used to build the invitation links sent to clients.
PUBLIC_APP_URL=http://localhost:5173

# --- Uploaded documents --------------------------------------------------------------------
MAX_FILE_SIZE_MB=20
MAX_PAGES=60
MAX_UNCOMPRESSED_MB=200
LIBREOFFICE_PATH=soffice
LIBREOFFICE_TIMEOUT_S=120
# Page images sent to the model: resolution and longest side in pixels.
RENDER_DPI=150
RENDER_MAX_PX=1568

# --- Language models -----------------------------------------------------------------------
# Models, providers and the default model live in llm_catalog.toml (versioned).
# LLM_CATALOG_FILE=/path/to/another_catalog.toml
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
LLM_REPAIR_ATTEMPTS=1
# Long documents are extracted in parts of this many pages, several parts at a time.
EXTRACTION_PAGES_PER_PART=8
EXTRACTION_PARALLEL_PARTS=4
# Items still without a correct answer after the parts are merged get one extra call that
# reads only the answer-key pages (multi-page or image-only keys). false turns it off.
EXTRACTION_ANSWER_KEY_PASS=true

# API key per provider of the catalog ([providers.<id>] in llm_catalog.toml). A model is
# enabled only when its provider has a key; REQUIRED: at least one of them.
GEMINI_API_KEY=
LLM_API_KEYS={"openai": "", "deepseek": ""}

# --- Client access -------------------------------------------------------------------------
# REQUIRED. Client keys are stored as HMAC hashes keyed with this secret. Generate it once:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every client key.
API_KEY_PEPPER=change-me-to-a-long-random-secret
# Clients and administrators live in this database: a SQLite file in backend/data/ by default,
# a Postgres URL in the cloud. Create the first administrator with: just backend::create-admin
# DATABASE_URL=sqlite:////absolute/path/giunti.db
